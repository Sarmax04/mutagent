# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
# OpenAI-compatible base URL: copy it from the Nebius Token Factory docs.
NEBIUS_BASE_URL=
# Model IDs: copy them from the Token Factory model catalog.
#   FAST   -> a small, cheap Nemotron model (routine calls such as triage)
#   STRONG -> a larger Nemotron model (writing tests, reasoning about survivors)
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_STRONG=
# Hard cap on total tokens (prompt + completion) per run.
NEBIUS_TOKEN_BUDGET=200000

# --- Web demo (`mutagent serve`); all optional, defaults shown ---
# Live runs switch on only when the four NEBIUS_* values above are set.
# MUTAGENT_MAX_ROUNDS=3            rounds a visitor can ask for
# MUTAGENT_RUN_TOKEN_BUDGET=60000  token cap for one live run
# MUTAGENT_MAX_RUNS_PER_DAY=30     live runs per UTC day, whole server
# MUTAGENT_TEST_TIMEOUT=20         seconds per pytest run
# MUTAGENT_LIMITS=1                CPU/memory/file-size limits on test processes (Linux only)
# MUTAGENT_REPLAYS_DIR=            where recorded runs live (default: <repo>/replays)
